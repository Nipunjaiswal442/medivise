{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm --prefix frontend ci",
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "frontend/dist",
  "fluid": true,
  "functions": {
    "api/chat.ts": { "maxDuration": 120 },
    "api/ingest.ts": { "maxDuration": 120 },
    "api/status.ts": { "maxDuration": 10 }
  },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
