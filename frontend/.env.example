# URL of your Convex deployment, printed by `npx convex dev` (also CONVEX_URL in ../.env.local).
# Production builds (Vercel) need the PRODUCTION deployment URL here.
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# Legacy REST clients (only used by the unused Express backend and the LLM stub; safe to ignore)
# VITE_API_BASE_URL=/api
# VITE_LLM_BASE_URL=/api/llm
