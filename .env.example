# Medivise configuration — where each variable lives.
#
# 1) Frontend (frontend/.env, copy from frontend/.env.example)
#      VITE_CONVEX_URL=https://<your-deployment>.convex.cloud
#
# 2) Convex deployment variables (NOT a file: set with the CLI, per deployment)
#      npx convex env set ML_SERVICE_URL https://your-ml-service.example.com   # optional
#      npx convex env set --prod ML_SERVICE_URL https://...                     # production
#      FIREBASE_PROJECT_ID defaults to medivise-45810 (see convex/auth.config.ts)
#
# 3) `npx convex dev` writes CONVEX_DEPLOYMENT / CONVEX_URL to .env.local (git-ignored).
#
# Firebase web config is public by design and lives in frontend/src/config/firebase.ts.
